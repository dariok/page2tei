               <lb facs="#P1_TL00173"/><w>eingestellt</w> <w>worden</w><pc>,</pc> <w>jedoch</w> <w>nicht</w> <w>wegen</w>
               <lb facs="#P1_TL00174"/><w>der</w> <pc>„</pc><w>Invasoren</w><pc>“</pc><pc>.</pc> <w>Helgoland</w> <w>wurde</w> <w>zuletzt</w>
               <lb facs="#P1_TL00175"/><w>am</w> <num>18</num><pc>.</pc> <w>Dezember</w> <w>bombardiert</w><pc>.</pc></p></body>
      </x:expect>
   </x:scenario>
   
