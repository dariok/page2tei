         <body><p facs="#P1_TB00034 #P1_TB00035">
               <cb/><lb facs="#P1_TL00169"/><w>Ein</w> <w>Sprecher</w> <w>des</w> <w>britischen</w> 
               <w>Luftfahrt<pc>¬</pc><lb facs="#P1_TL00170" break="no"/>ministeriums</w> <w>in</w> <w>London</w> <w>erklärte</w> <w>am</w> 
               <w>Don<pc>¬</pc><lb facs="#P1_TL00171" break="no"/>nerstag</w><pc>,</pc> <w>die</w> <w>Übungsbombardements</w> 
